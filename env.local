# OAuth Configuration
# Copy this file to .env.local and add your OAuth credentials

# Backend API URL
# Production: http://4.213.213.99
# Local: http://localhost:3002
NEXT_PUBLIC_API_URL=http://4.213.213.99

# Use dummy data instead of API (set to 'true' for testing when backend is down)
# When false, API will be used. If API fails, it will fallback to manual data from localStorage
NEXT_PUBLIC_USE_DUMMY_DATA=false

# Google OAuth - Get from Google Cloud Console
NEXT_PUBLIC_GOOGLE_CLIENT_ID=813436317140-v98ko2vrecd7s7veugsllbm25jgl9hud.apps.googleusercontent.com

# Microsoft OAuth - Get from Azure Portal
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=

# LinkedIn OAuth - Get from LinkedIn Developer Portal
NEXT_PUBLIC_LINKEDIN_CLIENT_ID=77kszicu8yww81

